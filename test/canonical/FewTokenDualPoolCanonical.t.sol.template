    function test_canonicalFactory_adapterCompletesInitializeBootstrapTwoWaySwapAndRedeposit()
        public
    {
        PoolKey memory poolKey = _poolKey(FEE_PIPS, 10);

        uint256 gasBefore = gasleft();
        vm.prank(owner);
        hook.initializePool(
            poolKey, _config(IERC4626(address(adapter0)), IERC4626(address(adapter1)))
        );
        emit log_named_uint("canonical_initialize_gas", gasBefore - gasleft());

        _mintWrapped(fewToken0, origin0, owner, BOOTSTRAP);
        _mintWrapped(fewToken1, origin1, owner, BOOTSTRAP);
        vm.startPrank(owner);
        fewToken0.approve(address(hook), BOOTSTRAP);
        fewToken1.approve(address(hook), BOOTSTRAP);
        gasBefore = gasleft();
        uint256 poolShares = hook.bootstrap(poolKey, BOOTSTRAP, BOOTSTRAP);
        emit log_named_uint("canonical_bootstrap_gas", gasBefore - gasleft());
        vm.stopPrank();

        assertGt(poolShares, 0, "bootstrap shares");
        assertGt(adapter0.balanceOf(address(hook)), 0, "currency0 adapter shares");
        assertGt(adapter1.balanceOf(address(hook)), 0, "currency1 adapter shares");
        assertEq(fewToken0.balanceOf(address(hook)), 0, "currency0 was not deposited");
        assertEq(fewToken1.balanceOf(address(hook)), 0, "currency1 was not deposited");

        _mintWrapped(fewToken0, origin0, address(this), 100 * UNIT);
        _mintWrapped(fewToken1, origin1, address(this), 100 * UNIT);
        fewToken0.approve(address(swapRouter), type(uint256).max);
        fewToken1.approve(address(swapRouter), type(uint256).max);

        gasBefore = gasleft();
        swap(poolKey, true, -int256(10 * UNIT), "");
        emit log_named_uint("canonical_swap_zero_for_one_gas", gasBefore - gasleft());
        assertEq(manager.getLiquidity(poolKey.toId()), 0, "orphaned JIT liquidity after first swap");

        gasBefore = gasleft();
        swap(poolKey, false, -int256(10 * UNIT), "");
        emit log_named_uint("canonical_swap_one_for_zero_gas", gasBefore - gasleft());
        assertEq(
            manager.getLiquidity(poolKey.toId()), 0, "orphaned JIT liquidity after second swap"
        );

        assertGt(adapter0.balanceOf(address(hook)), 0, "currency0 was not re-deposited");
        assertGt(adapter1.balanceOf(address(hook)), 0, "currency1 was not re-deposited");
        assertGt(originVault0.balanceOf(address(adapter0)), 0, "currency0 origin vault empty");
        assertGt(originVault1.balanceOf(address(adapter1)), 0, "currency1 origin vault empty");

        (uint256 reserve0, uint256 reserve1) = hook.getReserves(poolKey);
        uint256 preview0 = adapter0.convertToAssets(adapter0.balanceOf(address(hook)));
        uint256 preview1 = adapter1.convertToAssets(adapter1.balanceOf(address(hook)));
        uint256 adapterAssets0 = adapter0.totalAssets();
        uint256 adapterAssets1 = adapter1.totalAssets();
        emit log_named_uint("canonical_pool_shares", poolShares);
        emit log_named_uint(
            "currency0_adapter_virtual_share_rounding",
            adapterAssets0 > preview0 ? adapterAssets0 - preview0 : preview0 - adapterAssets0
        );
        emit log_named_uint(
            "currency1_adapter_virtual_share_rounding",
            adapterAssets1 > preview1 ? adapterAssets1 - preview1 : preview1 - adapterAssets1
        );
        emit log_named_uint(
            "currency0_non_adapter_inventory", reserve0 > preview0 ? reserve0 - preview0 : 0
        );
        emit log_named_uint(
            "currency1_non_adapter_inventory", reserve1 > preview1 ? reserve1 - preview1 : 0
        );
    }

